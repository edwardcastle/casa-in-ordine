# Transactional email (contact form, quote wizard, chat lead capture)
BREVO_API_KEY=

# Chat assistant, and the semantic screening of contact-form messages.
# Without it the forms still work: the message is judged by the character
# heuristics alone and every submission logs that the review was skipped.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-4-5
CHAT_MODEL=

# Cloudflare Turnstile — anti-abuse on the contact form and quote wizard.
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and add casainordine.com (plus localhost for development) to its hostnames.
#
# Without these the forms still run, but with the captcha layer disabled:
# the honeypot, fill-time floor, rate limit, address and content checks all
# stay active, and the server logs an error on every submission.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Client reviews and catalogue leads (submission forms, moderation, the
# /admin/reviews page).
#
# For local development, `docker compose up -d` then `pnpm migrate up` gives you
# a throwaway Postgres, and this line:
#   DATABASE_URL=postgres://cio:devpass@localhost:55432/casainordine
# Point local development at the production database only if you mean to write
# real client reviews and real leads from your laptop.
#
# Use the PUBLIC connection string from your database provider: Vercel runs
# outside their private network, so an internal host silently times out.
# Without it the review form refuses submissions and the homepage section stays
# hidden — the rest of the site is unaffected.
DATABASE_URL=

# Who may approve, reject and withdraw reviews. Comma-separated; each address
# signs in with an emailed link, so removing one here locks that person out
# immediately. Reuses BREVO_API_KEY to send both the link and the notifications.
ADMIN_EMAILS=

# Signs the admin session cookie. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Who receives the notification emails: new reviews, catalogue requests.
# Optional — falls back to ADMIN_EMAILS. Set it when someone needs to moderate
# the site without every lead landing in their inbox, or to notify a founder
# who never opens the admin.
NOTIFY_EMAILS=

# Origin used for links inside emails. Defaults to https://casainordine.com.
NEXT_PUBLIC_SITE_URL=

# Signs the client-area session cookie (30 days). Required in production: the
# client area refuses to sign anyone in without it. At least 32 characters, and
# not the same value as ADMIN_SESSION_SECRET. Generate with: openssl rand -base64 32
CLIENT_SESSION_SECRET=

# Private file storage for the client area (Vercel Blob). On Vercel, connecting
# a private Blob store to the project provides what the SDK needs by itself:
# it authenticates with the project's OIDC token and finds the store through
# BLOB_STORE_ID, both injected into the deployment. If the store was created
# some other way, set BLOB_STORE_ID there yourself (it looks like store_xxxx).
# BLOB_READ_WRITE_TOKEN is only for local development, where there is no OIDC
# token: copy it from the store's page in the Vercel dashboard.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Integration tests (`pnpm test`) that need Postgres run against this database
# and are skipped without it. Its name must end in `_test`: the suites empty
# the client-area tables, and the helper refuses anything else.
#   TEST_DATABASE_URL=postgres://cio:devpass@localhost:55432/casainordine_test
TEST_DATABASE_URL=
